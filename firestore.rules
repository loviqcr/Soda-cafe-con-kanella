rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /libreta/principal {
      allow read, write: if request.auth != null;
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "nJR8brlKSIgWvdPO8gkA56zIxSp2";
    }
  }
}
